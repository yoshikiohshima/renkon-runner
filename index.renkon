((logs) => {
  if (!logs.log) {return;}
  window.Toastify({
    text: logs.log,
    duration: 750,
    stopOnFocus: false,
    gravity: "bottom", // \`top\` or \`bottom\`
    position: "right", // \`left\`, \`center\` or \`right\`
    style: {
      background: "linear-gradient(to right, #00b09b, #96c93d)",
    },
  }).showToast();
})(logs);
*/`],
[`96`, `const outputs = Behaviors.select(
  {map: new Map()},
  addProcess, (prev, name) => {
    if (prev.map.get(name)) {
      return prev;
    }
    Renkon.merge([\`
      function merged({}) {
        const \${name}_logger = component({name: "\${name}", serverURL, ticker}, "\${name}");
        return []
      }\`]);
    prev.map.set(name, name);
  }
);

const component = Renkon.component(Renkon.findDecl("loggingComponent"));

const ticker = Events.timer(500);

const requestDone = Events.resolvePart(onStatusChange);

const addProcess = requestDone.name;

const gathered = Behaviors.gather("_logger\$");

((gathered, selectedProgram) => {
  if (!selectedProgram) {return;}
  const log = gathered[selectedProgram.name + "_logger"];
  console.log(log);
  if (!log?.log?.value) {return;}
  window.Toastify({
    text: log.log.value,
    duration: 750,
    stopOnFocus: false,
    gravity: "bottom", // \`top\` or \`bottom\`
    position: "right", // \`left\`, \`center\` or \`right\`
    style: {
      background: "linear-gradient(to right, #00b09b, #96c93d)",
    },
  }).showToast();
})(gathered, selectedProgram);`]]}